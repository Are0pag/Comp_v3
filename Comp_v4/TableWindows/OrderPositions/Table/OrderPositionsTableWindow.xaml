<windows:TableWindowBase x:Class="Comp_v4.TableWindows.OrderPositions.Table.OrderPositionsTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Comp_v4.TableWindows.OrderPositions.Table"
        xmlns:form="clr-namespace:Comp_v4.TableWindows.OrderPositions.Form"
        xmlns:form1="clr-namespace:Comp_v4.TableWindows.SupplierOrders.Form;assembly=Utils"
        xmlns:windows="clr-namespace:Utils.WPF.Windows;assembly=Utils"
        mc:Ignorable="d"
        Title="Состав заказа" Height="900" Width="1200"
        PreviewKeyDown="SupplierOrderTableWindow_OnPreviewKeyDown"
        PreviewMouseDown="SupplierOrderTableWindow_OnPreviewMouseDown">
    
    <windows:TableWindowBase.Resources>
        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <form1:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </windows:TableWindowBase.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Height="40">
            <Button x:Name="AddButton" 
                    Content="{Binding Label}" 
                    Command="{Binding ClickCommand}" 
                    Style="{StaticResource ToolBarButtonStyle}"/>
            <Button x:Name="EditButton" 
                    Content="{Binding Label}" 
                    Command="{Binding ClickCommand}" 
                    Style="{StaticResource ToolBarButtonStyle}"/>
            <Button x:Name="DeleteButton" 
                    Content="{Binding Label}" 
                    Command="{Binding ClickCommand}" 
                    Style="{StaticResource ToolBarButtonStyle}"/>
            
            <Grid x:Name="FilterGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" x:Name="FilterTextBox"
                         Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         Width="200" Height="25" Margin="20,0,0,0" 
                         VerticalContentAlignment="Center"/>

                <CheckBox Grid.Row="1" x:Name="IgnoreCaseCheckBox" 
                          Content="Учёт регистра" 
                          IsChecked="{Binding IgnoreCase, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          FontSize="10"
                          HorizontalAlignment="Left"
                          Margin="20,0,0,0"/>
            </Grid>
        </StackPanel>
        
<DataGrid Grid.Row="1" 
          x:Name="DataGrid" 
          ItemsSource="{Binding ItemsSorted}"
          SelectedItem="{Binding SelectedItem}"
          Margin="10" 
          AutoGenerateColumns="False" 
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          MouseDoubleClick="DataGrid_OnMouseDoubleClick"
          SelectionChanged="DataGrid_OnSelectionChanged"> 
    <DataGrid.Columns>
        <!-- Блокируем чтение для остальных колонок через IsReadOnly="True" -->
        <DataGridTextColumn Header="Наименование позиции" Binding="{Binding Position.Name}" Width="Auto" IsReadOnly="True"/>
        <DataGridTextColumn Header="Номенклатурный номер" Binding="{Binding Position.NomenclatureNumber}" Width="Auto" IsReadOnly="True"/>
        <DataGridTextColumn Header="Номер по каталогу" Binding="{Binding Position.CatalogNumber}" Width="Auto" IsReadOnly="True"/>
        <DataGridTextColumn Header="Типоразмер" Binding="{Binding Position.TypeSize.Designation}" Width="Auto" IsReadOnly="True"/>
        <DataGridTextColumn Header="Производитель" Binding="{Binding Position.Manufacturer.Designation}" Width="Auto" IsReadOnly="True"/>
        <DataGridTextColumn Header="Ед. изм-я" Binding="{Binding Position.ConditionalDesignation.Designation}" Width="Auto" IsReadOnly="True"/>
        
        <!-- РЕДАКТИРУЕМЫЕ КОЛОНКИ (IsReadOnly по умолчанию False, указывать не обязательно) -->
        <DataGridTextColumn Header="Кол-во заказано" Binding="{Binding OrderQuantity, UpdateSourceTrigger=LostFocus}" Width="Auto"/>
        <DataGridTextColumn Header="Кол-во получено" Binding="{Binding ReceivedQuantity, UpdateSourceTrigger=LostFocus}" Width="Auto" IsReadOnly="True"/>
        
        <!-- Шаблонная колонка по умолчанию IsReadOnly, если внутри TextBlock -->
        <DataGridTemplateColumn Header="Статус получения" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding ReceiveStatusEnumValue, Converter={StaticResource EnumDescriptionConverter}}"/>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        
        <DataGridTextColumn Header="Цена за ед." Binding="{Binding UnitPrice, StringFormat=N2}" Width="Auto"/>
        <DataGridTextColumn Header="Сумма стоимости" Binding="{Binding TotalCost, StringFormat=N2}" Width="Auto" IsReadOnly="True"/>
    </DataGrid.Columns>
    
    <DataGrid.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="InfoDataGridContextMenuAddNewItemCommand" 
                      Header="Создать" Command="{Binding ClickCommand}"></MenuItem>
            <MenuItem x:Name="InfoDataGridContextMenuEditItemCommand"
                      Header="Редактировать" Command="{Binding ClickCommand}"></MenuItem>
            <MenuItem x:Name="InfoDataGridContextMenuDeleteItemCommand"
                      Header="Удалить" Command="{Binding ClickCommand}"></MenuItem>
        </ContextMenu>
    </DataGrid.ContextMenu>
    
</DataGrid>
        
    </Grid>
</windows:TableWindowBase>
